# For local development run: make install && make setup
DATABASE_URL=sqlite:///./email_checker.db
# Generate once with: ../.venv/bin/python -m app.manage key (from backend)
# Railway web and worker MUST share the same key. Back it up separately.
ENCRYPTION_KEY=
LOCAL_DATABASE_PASSWORD=
PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_COOKIES=false
PRODUCTION=false
RETENTION_HOURS=24
MAX_BATCH_ROWS=1000
MAX_UPLOAD_BYTES=5242880
MAX_ACTIVE_JOBS=2
MAX_JOBS_PER_HOUR=30
JOB_TIMEOUT_SECONDS=1800
# Provider credentials are saved per account through Settings, not shared here.
